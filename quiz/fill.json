   "id": "f128",
   "subject": "信号与系统",
   "sub": "Z变换性质",
   "q": "Z 变换的频域（z 域）尺度变换性质？",
   "a": "$z_0^n x[n]\\leftrightarrow X\\left(\\frac{z}{z_0}\\right)$，收敛域变为 $|z_0|R$",
   "tag": ""
  },
  {
   "id": "f129",
   "subject": "信号与系统",
   "sub": "Z变换性质",
   "q": "Z 变换的时间反转性质？",
   "a": "$x[-n]\\leftrightarrow X\\left(\\frac{1}{z}\\right)$，收敛域变为 $\\frac{1}{R}$",
   "tag": ""
  },
