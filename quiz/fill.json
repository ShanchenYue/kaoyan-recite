   "id": "f004",
   "subject": "信号与系统",
   "sub": "拉普拉斯变换对",
   "q": "冲激偶 $\\delta^{\\prime}(t)$ 的傅里叶变换与拉普拉斯变换？",
   "a": "$F(\\omega)=j\\omega$；$L(s)=s$，全 $s$ 平面",
   "tag": ""
  },
  {
   "id": "f005",
   "subject": "信号与系统",
   "sub": "拉普拉斯变换对",
   "q": "单边指数信号 $e^{-at}u(t)$ 的傅里叶变换与拉普拉斯变换？",
   "a": "$F(\\omega)=\\frac{1}{a+j\\omega}$；$L(s)=\\frac{1}{s+a}$，$Re(s)>-a$",
   "tag": ""
  },
  {
   "id": "f006",
   "subject": "信号与系统",
   "sub": "拉普拉斯变换对",
   "q": "双边指数信号 $e^{-a|t|}$ 的傅里叶变换与双边拉普拉斯变换？",
   "a": "$F(\\omega)=\\frac{2a}{a^2+\\omega^2}$；$L(s)=\\frac{2a}{a^2-s^2}$，$-a<Re(s)<a$",
   "tag": ""
  },
  {
   "id": "f007",
   "subject": "信号与系统",
   "sub": "拉普拉斯变换对",
   "q": "符号函数 $sgn(t)$ 的傅里叶变换与（单边）拉普拉斯变换？",
   "a": "$F(\\omega)=\\frac{2}{j\\omega}$；单边 $L(s)=\\frac{1}{s}$（$t>0$ 时 $sgn(t)=1$）",
   "tag": ""
  },
  {
   "id": "f008",
   "subject": "信号与系统",
   "sub": "拉普拉斯变换对",
   "q": "矩形窗 $E\\left[u\\left(t+\\frac{\\tau}{2}\\right)-u\\left(t-\\frac{\\tau}{2}\\right)\\right]$ 的变换？",
   "a": "$F(\\omega)=E\\tau\\,Sa\\left(\\frac{\\omega\\tau}{2}\\right)$；$L(s)=\\frac{E}{s}\\left(e^{\\frac{s\\tau}{2}}-e^{-\\frac{s\\tau}{2}}\\right)=\\frac{2E}{s}sh\\left(\\frac{s\\tau}{2}\\right)$",
   "tag": ""
  },
  {
   "id": "f009",
   "subject": "信号与系统",
   "sub": "拉普拉斯变换对",
   "q": "$t\\,u(t)$ 的傅里叶变换与拉普拉斯变换？",
   "a": "$F(\\omega)=j\\pi\\delta^{\\prime}(\\omega)-\\frac{1}{\\omega^2}$；$L(s)=\\frac{1}{s^2}$",
   "tag": ""
  },
  {
   "id": "f010",
   "subject": "信号与系统",
   "sub": "拉普拉斯变换对",
   "q": "$t^2u(t)$ 的傅里叶变换与拉普拉斯变换？",
   "a": "$F(\\omega)=-\\pi\\delta^{\\prime\\prime}(\\omega)+\\frac{2j}{\\omega^3}$；$L(s)=\\frac{2}{s^3}$",
