   "id": "f138",
   "subject": "信号与系统",
   "sub": "DFT性质",
   "q": "DFT 的频移性质？",
   "a": "$e^{j\\frac{2\\pi k_0n}{N}}x[n]\\leftrightarrow X[(k-k_0)_N]$",
   "tag": ""
  },
  {
   "id": "f139",
   "subject": "信号与系统",
   "sub": "DFT性质",
   "q": "DFT 的共轭性质？",
   "a": "$x^*[n]\\leftrightarrow X^*[(-k)_N]$",
   "tag": ""
  },
  {
   "id": "f140",
   "subject": "信号与系统",
   "sub": "DFT性质",
   "q": "DFT 的时间反转性质？",
   "a": "$x[(-n)_N]\\leftrightarrow X[(-k)_N]$",
   "tag": ""
  },
  {
   "id": "f141",
   "subject": "信号与系统",
   "sub": "DFT性质",
   "q": "DFT 的循环卷积定理？",
   "a": "$x[n]\\circledast y[n]\\leftrightarrow X[k]Y[k]$",
   "tag": ""
  },
  {
   "id": "f142",
   "subject": "信号与系统",
   "sub": "DFT性质",
   "q": "DFT 的相乘（时域相乘）性质？",
   "a": "$x[n]y[n]\\leftrightarrow\\frac{1}{N}X[k]\\circledast Y[k]$",
   "tag": ""
  },
  {
   "id": "f143",
   "subject": "信号与系统",
   "sub": "DFT性质",
   "q": "DFT 的时域差分性质？",
   "a": "$x[n]-x[n-1]\\leftrightarrow(1-W_N^k)X[k]$",
   "tag": ""
  },
  {
   "id": "f144",
   "subject": "信号与系统",
   "sub": "DFT性质",
   "q": "DFT 的累加性质？",
   "a": "$\\sum_{m=-\\infty}^{n}x[m]\\leftrightarrow\\frac{X[k]}{1-W_N^k}$",
   "tag": ""
  },
  {
   "id": "f145",
   "subject": "信号与系统",
   "sub": "DFT性质",
   "q": "实信号 DFT 的共轭对称性？",
   "a": "$X[k]=X^*[(-k)_N]$",
   "tag": ""
  },
  {
   "id": "f146",
   "subject": "信号与系统",
   "sub": "DFT性质",
   "q": "实偶信号 DFT 的对称性？",
   "a": "$X[k]$ 为实偶序列",
   "tag": ""
  },
  {
   "id": "f147",
   "subject": "信号与系统",
   "sub": "DFT性质",
   "q": "实奇信号 DFT 的对称性？",
   "a": "$X[k]$ 为纯虚奇序列",
   "tag": ""
  },
  {
   "id": "f148",
   "subject": "信号与系统",
   "sub": "DFT性质",
   "q": "DFT 的帕塞瓦尔定理？",
   "a": "$\\sum_{n=0}^{N-1}|x[n]|^2=\\frac{1}{N}\\sum_{k=0}^{N-1}|X[k]|^2$",
   "tag": ""
  },
