   "tag": ""
  },
  {
   "id": "f126",
   "subject": "信号与系统",
   "sub": "Z变换性质",
   "q": "Z 变换的线性性质？",
   "a": "$ax_1[n]+bx_2[n]\\leftrightarrow aX_1(z)+bX_2(z)$，收敛域至少为两收敛域的交集",
   "tag": ""
  },
  {
   "id": "f127",
   "subject": "信号与系统",
   "sub": "Z变换性质",
   "q": "Z 变换的时移性质？",
   "a": "$x[n-n_0]\\leftrightarrow z^{-n_0}X(z)$，收敛域不变（$z=0$ 或 $\\infty$ 可能例外）",
   "tag": ""
  },
