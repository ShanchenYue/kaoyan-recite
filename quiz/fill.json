  {
   "id": "f001",
   "subject": "信号与系统",
   "sub": "拉普拉斯变换对",
   "q": "单位阶跃 $u(t)$ 的傅里叶变换与拉普拉斯变换？",
   "a": "$F(\\omega)=\\frac{1}{j\\omega}+\\pi\\delta(\\omega)$；$L(s)=\\frac{1}{s}$，$Re(s)>0$",
   "tag": ""
  },
  {
   "id": "f002",
   "subject": "信号与系统",
   "sub": "拉普拉斯变换对",
   "q": "单位冲激 $\\delta(t)$ 的傅里叶变换与拉普拉斯变换？",
   "a": "$F(\\omega)=1$；$L(s)=1$，全 $s$ 平面",
   "tag": ""
  },
  {
   "id": "f003",
   "subject": "信号与系统",
   "sub": "拉普拉斯变换对",
   "q": "常数 $1$ 的傅里叶变换与拉普拉斯变换？",
   "a": "$F(\\omega)=2\\pi\\delta(\\omega)$；$L(s)=\\frac{1}{s}$，$Re(s)>0$",
   "tag": ""
  },
