  },
  {
   "id": "f119",
   "subject": "信号与系统",
   "sub": "Z变换对",
   "q": "$\\cos(\\omega_0n)u[n]$ 的 Z 变换与收敛域？",
   "a": "$X(z)=\\frac{z(z-\\cos\\omega_0)}{z^2-2z\\cos\\omega_0+1}$，$|z|>1$",
   "tag": ""
  },
  {
   "id": "f120",
   "subject": "信号与系统",
   "sub": "Z变换对",
   "q": "$\\sin(\\omega_0n)u[n]$ 的 Z 变换与收敛域？",
   "a": "$X(z)=\\frac{z\\sin\\omega_0}{z^2-2z\\cos\\omega_0+1}$，$|z|>1$",
   "tag": ""
  },
  {
   "id": "f121",
   "subject": "信号与系统",
   "sub": "Z变换对",
   "q": "$\\cos\\left(\\frac{\\pi}{2}n\\right)u[n]$ 的 Z 变换？",
   "a": "$X(z)=\\frac{z^2}{z^2+1}$，$|z|>1$",
   "tag": ""
  },
  {
   "id": "f122",
   "subject": "信号与系统",
   "sub": "Z变换对",
   "q": "$\\sin\\left(\\frac{\\pi}{2}n\\right)u[n]$ 的 Z 变换？",
   "a": "$X(z)=\\frac{z}{z^2+1}$，$|z|>1$",
   "tag": ""
  },
  {
   "id": "f123",
   "subject": "信号与系统",
   "sub": "Z变换对",
   "q": "$r^n\\cos(\\omega_0n)u[n]$ 的 Z 变换与收敛域？",
   "a": "$X(z)=\\frac{z(z-r\\cos\\omega_0)}{z^2-2rz\\cos\\omega_0+r^2}$，$|z|>r$",
