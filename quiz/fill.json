   "tag": ""
  },
  {
   "id": "f132",
   "subject": "信号与系统",
   "sub": "Z变换性质",
   "q": "Z 变换的卷积定理？",
   "a": "$x_1[n]*x_2[n]\\leftrightarrow X_1(z)X_2(z)$，收敛域至少为两收敛域的交集",
   "tag": ""
  },
  {
   "id": "f133",
   "subject": "信号与系统",
   "sub": "Z变换性质",
   "q": "Z 变换的频域微分性质？",
   "a": "$n\\,x[n]\\leftrightarrow -z\\frac{dX(z)}{dz}$",
   "tag": ""
  },
  {
   "id": "f134",
   "subject": "信号与系统",
   "sub": "Z变换性质",
   "q": "Z 变换的初值定理？",
   "a": "若 $x[n]$ 为因果信号，则 $x[0]=\\lim_{z\\to\\infty}X(z)$",
   "tag": ""
  },
  {
   "id": "f135",
   "subject": "信号与系统",
   "sub": "Z变换性质",
   "q": "Z 变换的终值定理？",
   "a": "若 $x[n]$ 为因果信号且极点在单位圆内，则 $\\lim_{n\\to\\infty}x[n]=\\lim_{z\\to1}(z-1)X(z)$",
   "tag": ""
  },
  {
   "id": "f136",
   "subject": "信号与系统",
   "sub": "DFT性质",
   "q": "DFT 的线性性质？",
   "a": "$a\\,x[n]+b\\,y[n]\\leftrightarrow aX[k]+bY[k]$",
   "tag": ""
  },
